# Copy this file to .env and fill it in ONLY for a public testnet deployment (docs/DEPLOY.md).
# .env is git-ignored. Use throwaway testnet accounts from a wallet that has never held real
# funds; never put a key that controls real money here.

# Any Sepolia JSON-RPC endpoint (the public one below works without an account).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Two different MetaMask accounts: the regulator deploys and accepts; the estimator attests.
# (The contract forbids the regulator from also being an estimator.)
REGULATOR_PRIVATE_KEY=
ESTIMATOR_PRIVATE_KEY=

# Optional: lets `npx hardhat verify` publish the source on Etherscan (Sourcify needs no key).
ETHERSCAN_API_KEY=

# Where the evidence files can be downloaded. It is written permanently into each Attested
# event, so set it only once the repository is public, with your real GitHub user name in place
# of Adan-Khalid, then remove the leading "# ". While it stays commented out, the
# scripts emit the repo-relative path chain/evidence/<file> instead.
# EVIDENCE_BASE_URI=https://raw.githubusercontent.com/Adan-Khalid/invisible-solar-pk/main/chain/evidence/
