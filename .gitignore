# `npm run deploy:local` / `anchor:local` records (localhost.json, and localhost.previous.json,
# localhost.previous-2.json, ... after REDEPLOY=1): the local Hardhat node forgets them when it stops.
# Keep chain/deployments/sepolia*.json, hardhat-demo.json and remix-args.json: they are published.
chain/deployments/localhost*.json

# Local scratch output, not part of the published site
docs/proof/

# Archives and logs
*.zip
*.log

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# Secrets: never commit (.env.example is the empty template)
.env
.env.*
!.env.example
# Key and wallet material: TLS/SSH keys, certificate bundles, keystore folders, geth keystore files
*.pem
*.key
*.p12
*.pfx
keystore/
UTC--*

